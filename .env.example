# ---------------------------------------------------------------
# Scents by Ilham environment. Copy to .env.local and fill in.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are
# visible in the browser — never put secrets in them.
# ---------------------------------------------------------------

# Public site URL (canonical links, sitemap, share images).
# On Netlify this falls back to the site's own URL automatically.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------
# Server-only (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------

# The dashboard password (12+ characters). Leave empty to switch sign-in off.
# Mark as secret in Netlify. Changing it signs everyone out.
ADMIN_PASSWORD=

# The name shown in the dashboard and recorded against every admin action.
ADMIN_NAME=Ilham

# Signs the admin session and customers' order-access cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Storage: "netlify-blobs" (detected automatically on Netlify) or "file" (local / Node server).
# SBI_STORAGE=file

# Local database and uploads (file storage only). Outside /public, never committed.
SBI_DATA_DIR=.data
